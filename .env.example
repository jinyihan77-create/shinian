# 腾讯云模板。不要覆盖已有 .env.local，不要提交任何真实值。
# 所有变量仅服务器使用，不使用 NEXT_PUBLIC_ 前缀。
CLOUD_PROVIDER=cloudbase
CLOUDBASE_ENV_ID=
CLOUDBASE_REGION=ap-shanghai
# 该环境实际开通并验证成功的模型名称
CLOUDBASE_AI_MODEL=
OWNER_USERNAME=echo-owner
OWNER_EMAIL=
# 最终正式 HTTPS 来源地址，不含路径、查询或账号信息
APP_ORIGIN=

# CLI 授权由部署执行者在本机完成。
# 初始密码由 setup-tencent 生成到 .env.tencent-owner.local。
# 不需要 OpenAI、Vercel 或 Supabase 密钥；不把管理员凭据放进镜像或浏览器。
