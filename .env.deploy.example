# 复制为 .env.local，在本机填写；不要把真实值贴到聊天或提交到仓库。
# 网站运行：Supabase 项目设置中的项目地址与 publishable/anon key。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 可选的初始账号；留空时网站开放普通用户注册，每个账号只访问自己的资料。
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=

# 仅用于本机初始化数据库和账号，不打包进网页。
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# 真实 AI：有效服务密钥和该账号有权限使用的模型。
OPENAI_API_KEY=
AI_MODEL=

# 最终公开 HTTPS 网站地址，部署完成后填写。
APP_ORIGIN=

# 部署授权：首次发布前运行 npx wrangler login，在浏览器完成 Cloudflare 授权。
