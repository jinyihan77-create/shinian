# 复制为 .env.local，在本机填写；不要把真实值贴到聊天或提交到仓库。
# 网站运行：Supabase 项目设置中的项目地址与 publishable/anon key。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 私人账户：仅允许此邮箱登录使用。首次账号设置时使用初始密码。
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=

# 仅用于本机初始化数据库和账号，不打包进网页。
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# 真实 AI：有效服务密钥和该账号有权限使用的模型。
OPENAI_API_KEY=
AI_MODEL=

# 最终公开 HTTPS 网站地址，部署完成后填写。
APP_ORIGIN=

# 部署授权：可在浏览器/CLI 登录 Vercel，或在本机填写个人部署 token。
VERCEL_TOKEN=
